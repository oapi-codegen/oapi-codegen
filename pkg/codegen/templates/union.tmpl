{{/* union.keepOtherUnions adds to the JSON object b, which a value of one of
the unions a type combines marshaled to, the keys of the union data t.union
that b's union doesn't own (the keys passed): the other unions' data (see
Schema.UnionOwnedKeys). A key b has keeps b's value. A null b leaves only the
other unions' data. When b or t.union is anything else that isn't an object,
b replaces the union data whole. The caller returns before it on an error, so
the union data doesn't change then. */ -}}
{{define "union.keepOtherUnions" -}}
    var object, kept map[string]json.RawMessage
    if json.Unmarshal(b, &object) == nil && json.Unmarshal(t.union, &kept) == nil && kept != nil {
        {{range . -}}
            delete(kept, {{printf "%q" .}})
        {{end -}}
        added := object == nil
        if added {
            object = make(map[string]json.RawMessage)
        }
        for key, value := range kept {
            if _, found := object[key]; !found {
                object[key] = value
                added = true
            }
        }
        if added {
            if b, err = json.Marshal(object); err != nil {
                return err
            }
        }
    }
{{- end}}
