{{range .Types}}
    {{$typeName := .TypeName -}}
    {{$discriminator := .Schema.Discriminator}}
    {{$schema := .Schema -}}
    {{$adopts := or (ne 0 (len .Schema.Properties)) .Schema.HasAdditionalProperties -}}
    {{if $adopts}}
        // adoptUnion reconciles {{$typeName}}'s own fields with the union data b that From*
        // or Merge* just put in place of previous, for the keys b defines. A property that is
        // unset, or still holds the value previous had for it, takes b's value; one the caller
        // has set to something else keeps it. Otherwise a zero value, or an earlier variant's
        // value, would overwrite b's when marshaling. A matching additional property is
        // dropped, so that an older copy of the key cannot shadow the new union data.
        func (t *{{$typeName}}) adoptUnion(previous, b json.RawMessage) {
            object := make(map[string]json.RawMessage)
            if json.Unmarshal(b, &object) != nil {
                return
            }
            held := make(map[string]json.RawMessage)
            _ = json.Unmarshal(previous, &held)
            {{range .Schema.Properties -}}
                if raw, found := object["{{.JsonFieldName}}"]; found {
                    var old, next {{.GoTypeDef}}
                    unchanged := json.Unmarshal(held["{{.JsonFieldName}}"], &old) == nil && reflect.DeepEqual(old, t.{{.GoFieldName}})
                    if (unchanged || reflect.ValueOf(t.{{.GoFieldName}}).IsZero()) && json.Unmarshal(raw, &next) == nil {
                        t.{{.GoFieldName}} = next
                    }
                }
            {{end -}}
            {{if .Schema.HasAdditionalProperties -}}
                for fieldName := range object {
                    delete(t.AdditionalProperties, fieldName)
                }
            {{end -}}
        }
    {{end}}
    {{range .Schema.UnionElements}}
        {{$stamp := $schema.DiscriminatorStampFor . -}}
        // As{{ .Method }} returns the union data inside the {{$typeName}} as a {{.}}
        func (t {{$typeName}}) As{{ .Method }}() ({{.}}, error) {
            var body {{.}}
            err := json.Unmarshal(t.union, &body)
            return body, err
        }

        // From{{ .Method }} overwrites any union data inside the {{$typeName}} as the provided {{.}}
        func (t *{{$typeName}}) From{{ .Method }} (v {{.}}) error {
            {{if and $stamp $stamp.Property -}}
                {{if $stamp.Property.IsPointer -}}
                    var discriminator {{$stamp.Property.Schema.TypeDecl}} = {{$stamp.Literal}}
                    t.{{$stamp.Property.GoFieldName}} = &discriminator
                {{else -}}
                    t.{{$stamp.Property.GoFieldName}} = {{$stamp.Literal}}
                {{end -}}
            {{end -}}
            b, err := json.Marshal(v)
            {{if $stamp -}}
                if err != nil {
                    return err
                }
                b, err = runtime.JSONMerge(b, []byte(`{{$stamp.JSONPatch}}`))
            {{end -}}
            {{if $adopts -}}
                previous := t.union
            {{end -}}
            t.union = b
            {{if $adopts -}}
                if err == nil {
                    t.adoptUnion(previous, b)
                }
            {{end -}}
            return err
        }

        // Merge{{ .Method }} performs a merge with any union data inside the {{$typeName}}, using the provided {{.}}
        func (t *{{$typeName}}) Merge{{ .Method }} (v {{.}}) error {
            {{if and $stamp $stamp.Property -}}
                {{if $stamp.Property.IsPointer -}}
                    var discriminator {{$stamp.Property.Schema.TypeDecl}} = {{$stamp.Literal}}
                    t.{{$stamp.Property.GoFieldName}} = &discriminator
                {{else -}}
                    t.{{$stamp.Property.GoFieldName}} = {{$stamp.Literal}}
                {{end -}}
            {{end -}}
            b, err := json.Marshal(v)
            if err != nil {
              return err
            }
            {{if $stamp -}}
                b, err = runtime.JSONMerge(b, []byte(`{{$stamp.JSONPatch}}`))
                if err != nil {
                    return err
                }
            {{end}}
            {{if $adopts -}}
                previous := t.union
            {{end -}}
            merged, err := runtime.JSONMerge(t.union, b)
            t.union = merged
            {{if $adopts -}}
                if err == nil {
                    t.adoptUnion(previous, b)
                }
            {{end -}}
            return err
        }
    {{end}}

    {{if $discriminator}}
        {{if $discriminator.IsString -}}
        func (t {{.TypeName}}) Discriminator() (string, error) {
            var discriminator struct {
                Discriminator string {{$discriminator.JSONTag}}
            }
            err := json.Unmarshal(t.union, &discriminator)
            return discriminator.Discriminator, err
        }
        {{- else -}}
        // Discriminator returns the {{$discriminator.ValueType}} discriminator as the text of its JSON value,
        // which is how the discriminator mapping spells it.
        func (t {{.TypeName}}) Discriminator() (string, error) {
            var discriminator struct {
                Discriminator json.RawMessage {{$discriminator.JSONTag}}
            }
            if err := json.Unmarshal(t.union, &discriminator); err != nil {
                return "", err
            }
            raw := discriminator.Discriminator
            switch {
            case len(raw) == 0 || string(raw) == "null":
                return "", nil
            case raw[0] == '"':
                var s string
                err := json.Unmarshal(raw, &s)
                return s, err
            }
            return string(raw), nil
        }
        {{- end}}

        {{$cases := $schema.DiscriminatorCases -}}
        {{if $cases}}
            func (t {{.TypeName}}) ValueByDiscriminator() (any, error) {
                discriminator, err := t.Discriminator()
                if err != nil {
                    return nil, err
                }
                switch discriminator{
                    {{range $cases -}}
                        case "{{.Value}}":
                            return t.As{{.Method}}()
                    {{end -}}
                    default:
                        return nil, errors.New("unknown discriminator value: "+discriminator)
                }
            }
        {{end}}
    {{end}}

    {{if .Schema.UnionTextKinds}}
        // UnmarshalText sets the union from the text of a path, query, header or cookie
        // parameter, which carries no JSON type. Text that is exactly a JSON
        // {{- if .Schema.UnionTextAccepts "boolean"}} boolean{{end}}
        {{- if .Schema.UnionTextAccepts "integer"}} integer{{end}}
        {{- if .Schema.UnionTextAccepts "number"}} number{{end}}, with nothing around it, is taken as one;
        {{- if .Schema.UnionTextAccepts "string"}} anything else is a string.{{else}} anything else is an error.{{end}}
        func (t *{{.TypeName}}) UnmarshalText(text []byte) error {
            {{if or (.Schema.UnionTextAccepts "boolean") (.Schema.UnionTextAccepts "integer") (.Schema.UnionTextAccepts "number") -}}
            var value any
            decoder := json.NewDecoder(bytes.NewReader(text))
            decoder.UseNumber()
            if len(bytes.TrimSpace(text)) == len(text) && json.Valid(text) && decoder.Decode(&value) == nil {
                {{- if .Schema.UnionTextAccepts "boolean"}}
                if _, ok := value.(bool); ok {
                    t.union = append(json.RawMessage(nil), text...)
                    return nil
                }
                {{- end}}
                {{- if or (.Schema.UnionTextAccepts "integer") (.Schema.UnionTextAccepts "number")}}
                if number, ok := value.(json.Number); ok {
                    {{- if .Schema.UnionTextAccepts "number"}}
                    t.union = json.RawMessage(number.String())
                    return nil
                    {{- else}}
                    if _, err := number.Int64(); err == nil {
                        t.union = json.RawMessage(number.String())
                        return nil
                    }
                    {{- end}}
                }
                {{- end}}
            }
            {{end -}}
            {{if .Schema.UnionTextAccepts "string" -}}
            b, err := json.Marshal(string(text))
            if err != nil {
                return err
            }
            t.union = b
            return nil
            {{- else -}}
            return fmt.Errorf("%q is not a valid {{.TypeName}}", text)
            {{- end}}
        }

        // Bind implements runtime.Binder, which binds exploded query parameters; see UnmarshalText.
        func (t *{{.TypeName}}) Bind(src string) error {
            return t.UnmarshalText([]byte(src))
        }
    {{end}}

    {{if not .Schema.HasAdditionalProperties}}

    func (t {{.TypeName}}) MarshalJSON() ([]byte, error) {
        b, err := t.union.MarshalJSON()
        {{if ne 0 (len .Schema.Properties) -}}
            if err != nil {
                return nil, err
            }
            object := make(map[string]json.RawMessage)
            if t.union != nil {
              err = json.Unmarshal(b, &object)
              if err != nil {
                return nil, err
              }
            }
            {{range .Schema.Properties}}
            {{if .RequiresNilCheck}}if t.{{.GoFieldName}} != nil { {{end}}
                object["{{.JsonFieldName}}"], err = json.Marshal(t.{{.GoFieldName}})
                if err != nil {
                    return nil, fmt.Errorf("error marshaling '{{.JsonFieldName}}': %w", err)
                }
            {{if .RequiresNilCheck}} }{{end}}
            {{end -}}
            b, err = json.Marshal(object)
        {{end -}}
        return b, err
    }

    func (t *{{.TypeName}}) UnmarshalJSON(b []byte) error {
        err := t.union.UnmarshalJSON(b)
        {{if ne 0 (len .Schema.Properties) -}}
            if err != nil {
                return err
            }
            object := make(map[string]json.RawMessage)
            err = json.Unmarshal(b, &object)
            if err != nil {
                return err
            }
            {{range .Schema.Properties}}
                if raw, found := object["{{.JsonFieldName}}"]; found {
                    err = json.Unmarshal(raw, &t.{{.GoFieldName}})
                    if err != nil {
                        return fmt.Errorf("error reading '{{.JsonFieldName}}': %w", err)
                    }
                }
            {{end}}
        {{end -}}
        return err
    }
    {{end}}
{{end}}
