        // Discriminator returns the {{$discriminator.ValueType}} discriminator as the text of its JSON value,
        // which is how the discriminator mapping spells it.
        func (t {{.TypeName}}) Discriminator() (string, error) {
            var discriminator struct {
                Discriminator json.RawMessage {{$discriminator.JSONTag}}
            }
            if err := json.Unmarshal(t.union, &discriminator); err != nil {
                return "", err
            }
            raw := discriminator.Discriminator
            switch {
            case len(raw) == 0 || string(raw) == "null":
                return "", nil
            case raw[0] == '"':
                var s string
                err := json.Unmarshal(raw, &s)
                return s, err
