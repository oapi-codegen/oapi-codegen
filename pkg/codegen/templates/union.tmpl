                {{- end}}
                {{- if or (.Schema.UnionTextAccepts "integer") (.Schema.UnionTextAccepts "number")}}
                if number, ok := value.(json.Number); ok {
                    {{- if .Schema.UnionTextAccepts "number"}}
                    t.union = json.RawMessage(number.String())
                    return nil
                    {{- else}}
                    if _, err := number.Int64(); err == nil {
