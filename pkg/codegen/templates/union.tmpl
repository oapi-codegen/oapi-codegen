        func (t *{{.TypeName}}) UnmarshalText(text []byte) error {
            {{if or (.Schema.UnionTextAccepts "boolean") (.Schema.UnionTextAccepts "integer") (.Schema.UnionTextAccepts "number") -}}
            var value any
            decoder := json.NewDecoder(bytes.NewReader(text))
            decoder.UseNumber()
            if len(bytes.TrimSpace(text)) == len(text) && json.Valid(text) && decoder.Decode(&value) == nil {
                {{- if .Schema.UnionTextAccepts "boolean"}}
