{{/*
Shared partials for the strict-server response templates. This file contributes
only {{define}} blocks to the base template tree; it emits nothing on its own.

"strict.responseHeaders" renders the 3-way (nullable / optional / plain) response
header-writing branch that every strict framework needs inside its Visit*Response
methods. The only per-framework difference is the header setter expression, passed
as .Setter (e.g. "w.Header().Set", "ctx.Response().Header.Set"); .Headers is the
response's []HeaderDefinition. Build the argument with the dict helper:
{{`{{template "strict.responseHeaders" (dict "Headers" $headers "Setter" "w.Header().Set")}}`}}

Values are serialized through runtime.StyleParamWithOptions rather than fmt.Sprint
so that format-carrying types (date-time, date, uuid, ...) go on the wire in the
representation the spec calls for, matching how the generated client parses them
back out. Every emitted write is wrapped in its own block so that the `v`/`err`
pair cannot collide with declarations in the surrounding Visit*Response body.
*/}}
{{define "strict.responseHeaders" -}}
{{- $setter := .Setter -}}
{{- range .Headers -}}
{{if .IsNullable -}}
if response.Headers.{{.GoName}}.IsSpecified() {
{{template "strict.styleResponseHeader" (dict "Header" . "Setter" $setter "Value" (printf "response.Headers.%s.MustGet()" .GoName))}}
}
{{else if .IsOptional -}}
if response.Headers.{{.GoName}} != nil {
{{template "strict.styleResponseHeader" (dict "Header" . "Setter" $setter "Value" (printf "*response.Headers.%s" .GoName))}}
}
{{else -}}
{{template "strict.styleResponseHeader" (dict "Header" . "Setter" $setter "Value" (printf "response.Headers.%s" .GoName))}}
{{end -}}
{{end -}}
{{end -}}

{{/*
"strict.styleResponseHeader" emits one guarded header write. .Header is a
ResponseHeaderDefinition, .Setter the framework's setter expression, and .Value
the already-dereferenced Go expression holding the header value.
*/}}
{{define "strict.styleResponseHeader" -}}
{
    v, err := runtime.StyleParamWithOptions("{{.Header.Style}}", {{.Header.Explode}}, "{{.Header.Name}}", {{.Value}}, runtime.StyleParamOptions{ParamLocation: runtime.ParamLocationHeader, Type: "{{.Header.SchemaType}}", Format: "{{.Header.SchemaFormat}}"})
    if err != nil {
        return fmt.Errorf("error styling response header {{.Header.Name}}: %w", err)
    }
    {{.Setter}}("{{.Header.Name}}", v)
}
{{- end -}}
